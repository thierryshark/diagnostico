x)/1.15 Poppins,sans-serif!important;letter-spacing:-.015em;color:var(--ol)!important;text-transform:none!important}\n.cml-vrx .hd h2 em{font-weight:300;font-style:italic}\n.cml-vrx .g3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}\n.cml-vrx .cd{display:flex;flex-direction:column;padding:10px 10px 20px;border:1px solid var(--ln);border-radius:16px;background:#fffaf2}\n.cml-vrx .cd img{display:block;width:100%!important;height:auto!important;aspect-ratio:4/3!important;object-fit:cover!important;border-radius:12px;background:#f3e8d6}\n.cml-vrx .cd .tg{align-self:flex-start;margin:16px 8px 0;padding:6px 10px;border-radius:10px;font:600 14px/1 Poppins,sans-serif}\n.cml-vrx .cd .tg.b{background:#f3e3c3;color:#7a420f}\n.cml-vrx .cd .tg.d{background:#e6ead6;color:#45502a}\n.cml-vrx .cd h3{margin:12px 8px 0;font:700 21px/1.2 Poppins,sans-serif;color:var(--ink)}\n.cml-vrx .cd p{flex:1;margin:8px 8px 0;font:400 15px/1.55 Poppins,sans-serif;color:var(--mu)}\n.cml-vrx .cd a{display:inline-flex;align-items:center;justify-content:center;min-height:46px;margin:18px 8px 0;border-radius:10px;font:600 15px/1 Poppins,sans-serif;text-decoration:none!important}\n.cml-vrx .cd a.o{border:1.5px solid var(--ol);color:var(--ol)!important}\n.cml-vrx .cd a.o:hover{background:var(--ol);color:#fff!important}\n.cml-vrx .cd a.f{background:var(--am);color:#fff!important}\n.cml-vrx.gh{margin-top:clamp(48px,6vw,80px)}\n@media(max-width:900px){.cml-vrx .g3{grid-template-columns:minmax(0,1fr)}.cml-vrx .cd{display:grid;grid-template-columns:42% minmax(0,1fr);column-gap:14px;align-items:start}.cml-vrx .cd img{grid-row:1/6;aspect-ratio:1/1!important}.cml-vrx .cd .tg{margin:4px 0 0}.cml-vrx .cd h3{margin:8px 0 0;font-size:18px}.cml-vrx .cd p{margin:6px 0 0;font-size:14px}.cml-vrx .cd a{margin:12px 0 0;min-height:44px}}\n@media(max-width:640px){#cml-vr img{aspect-ratio:896/1200!important}#cml-vr .tx{inset:0 0 auto 0;width:auto;justify-content:flex-start;padding:28px 20px 0}#cml-vr h1{font-size:32px!important}#cml-vr .s{font-size:15px;margin-top:12px}#cml-vr .ac{margin-top:18px}}\n</style>\n<section id=\"cml-vr\" class=\"cml-vrx w\" aria-label=\"Linha Verão\">\n<picture><source media=\"(max-width:640px)\" srcset=\"https://cdn.jsdelivr.net/gh/thierryshark/diagnostico@6392115ce7e13b199d5bb6f9b2143858daae8313/chefmaisleve-midia/verao/verao-mob.webp\"><img src=\"https://cdn.jsdelivr.net/gh/thierryshark/diagnostico@6392115ce7e13b199d5bb6f9b2143858daae8313/chefmaisleve-midia/verao/verao-desk.webp\" alt=\"Chá gelado, salada de frutas desidratadas e Laranja Chocoleve numa mesa clara de verão\" width=\"1584\" height=\"672\" fetchpriority=\"high\"></picture>\n<div class=\"tx\">\n<p class=\"k\">Novidade · Linha Verão</p>\n<h1>Para os dias quentes, <em>do nosso jeito.</em></h1>\n<p class=\"s\">Chá para tomar gelado, fruta crocante e Chocoleve. Tudo feito à mão na nossa cozinha, sem conservantes.</p>\n<div class=\"ac\"><a class=\"go\" href=\"#ns-section-product_list\">Ver o que já chegou</a><a class=\"lk\" href=\"#cml-vr-linhas\">Conhecer a linha</a></div>\n</div>\n</section>\n<section class=\"cml-vrx ln w\" id=\"cml-vr-linhas\">\n<div class=\"hd\"><p class=\"e\">A linha</p><h2>Três jeitos de <em>refrescar</em></h2></div>\n<div class=\"g3\">\n<article class=\"cd\"><img src=\"https://cdn.jsdelivr.net/gh/thierryshark/diagnostico@32bb2c13ba7c0b9fca06fa0ac04ddf8f9b14c7ba/chefmaisleve-midia/lancamentos/lc-verao.webp\" alt=\"Copos de chá gelado com frutas\" width=\"1000\" height=\"747\" loading=\"lazy\"><span class=\"tg b\">Em breve</span><h3>Chás para tomar gelado</h3><p>Chás mistos pensados para o gelo: frutas, flores e ervas que ficam ainda melhores frios.</p><a class=\"o\" href=\"https://wa.me/554791571974?text=Ol%C3%A1!%20Quero%20ser%20avisado%20do%20lan%C3%A7amento%20dos%20ch%C3%A1s%20gelados%20da%20Linha%20Ver%C3%A3o.\" target=\"_blank\" rel=\"noopener\">Quero ser avisado</a></article>\n<article class=\"cd\"><img src=\"https://cdn.jsdelivr.net/gh/thierryshark/diagnostico@6392115ce7e13b199d5bb6f9b2143858daae8313/chefmaisleve-midia/verao/salada-fruta.webp\" alt=\"Salada de frutas desidratadas crocantes numa tigela\" width=\"1200\" height=\"896\" loading=\"lazy\"><span class=\"tg b\">Em breve</span><h3>Salada de Fruta Crocante</h3><p>Morango, kiwi, pitaia, laranja, tangerina, abacaxi e banana desidratados, juntos num pacote. Enquanto ela não chega, as frutas já saem sozinhas aqui embaixo.</p><a class=\"o\" href=\"https://wa.me/554791571974?text=Ol%C3%A1!%20Quero%20ser%20avisado%20do%20lan%C3%A7amento%20da%20Salada%20de%20Fruta%20Crocante.\" target=\"_blank\" rel=\"noopener\">Quero ser avisado</a></article>\n<article class=\"cd\"><img src=\"https://cdn.jsdelivr.net/gh/thierryshark/diagnostico@add6c9420bb738617556e047fee22be42c5acff7/chefmaisleve-midia/ensaio/laranja-3.webp\" alt=\"Laranja Chocoleve servida com uma xícara de chá\" width=\"1024\" height=\"1024\" loading=\"lazy\"><span class=\"tg d\">Já disponível</span><h3>Linha Chocoleve</h3><p>Laranja, maçã, banana e abacaxi desidratados com chocolate 70%. Do gelo da geladeira direto para a pausa.</p><a class=\"f\" href=\"/snacks-granolas/chocoleve/\">Conhecer a Chocoleve</a></article>\n</div>\n</section>\n<div class=\"cml-vrx gh w hd\"><p class=\"e\">Já pode pedir</p><h2>Frutas crocantes e <em>Chocoleve</em></h2></div>\n", "width": "fill"}}}, "settings": {"_custom_name": "Linha Verao: abertura", "gap": 0, "horizontal_padding": 0, "section_width": "full", "vertical_padding": 0}}, "product_list": {"type": "main-products-grid", "disabled": false, "settings": {"columns": "4", "columns_mobile": "2", "horizontal_padding": 8, "pagination": "classic", "section_width": "full", "vertical_padding": 0}}, "custom_vrbot": {"type": "custom", "block_order": ["code_vrb"], "blocks": {"code_vrb": {"type": "code", "settings": {"code": "<!-- Chef Mais Leve: Linha Verao, conteudo (categoria). Codigo unico, sem script. -->\n<style>\n.cml-vrb{--ol:#565229;--ink:#2b2916;--mu:#5f5849;--am:#a65a14;--ln:#eadfcf;font-family:Poppins,system-ui,sans-serif;color:var(--ink)}\n.cml-vrb *{box-sizing:border-box}\n.cml-vrb .w{width:var(--cmlF,1240px);max-width:var(--cmlF,1240px);margin:0 auto}\n.cml-vrb .e{margin:0 0 10px;font:600 14px/1 Poppins,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:var(--am)}\n.cml-vrb h2{margin:0;font:700 clamp(26px,3vw,38px)/1.15 Poppins,sans-serif!important;letter-spacing:-.015em;color:var(--ol)!important;text-transform:none!important}\n.cml-vrb h2 em{font-weight:300;font-style:italic}\n.cml-vrb .pp{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(24px,4vw,56px);align-items:center;margin-top:clamp(56px,7vw,96px);padding:clamp(24px,4vw,48px);border-radius:16px;background:linear-gradient(135deg,#f1f2e2 0%,#e4e8cf 100%)}\n.cml-vrb .pp ol{margin:20px 0 0;padding:0;list-style:none;counter-reset:s}\n.cml-vrb .pp li{counter-increment:s;display:grid;grid-template-columns:40px minmax(0,1fr);gap:14px;padding:14px 0;border-top:1px solid rgba(86,82,41,.18)}\n.cml-vrb .pp li:before{content:\"0\" counter(s);font:300 24px/1 Poppins,sans-serif;color:var(--am)}\n.cml-vrb .pp li b{display:block;font:600 16px/1.3 Poppins,sans-serif;color:var(--ink)}\n.cml-vrb .pp li span{display:block;margin-top:4px;font:400 15px/1.5 Poppins,sans-serif;color:var(--mu)}\n.cml-vrb .pp img{display:block;width:100%!important;height:auto!important;aspect-ratio:4/3!important;object-fit:cover!important;border-radius:14px}\n.cml-vrb .fq{max-width:780px;margin:clamp(56px,7vw,96px) auto 0;text-align:center}\n.cml-vrb details{border-bottom:1px solid var(--ln);text-align:left}\n.cml-vrb details:first-of-type{margin-top:22px;border-top:1px solid var(--ln)}\n.cml-vrb summary{display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:56px;padding:14px 2px;cursor:pointer;list-style:none;font:500 16px/1.35 Poppins,sans-serif;color:var(--ink)}\n.cml-vrb summary::-webkit-details-marker{display:none}\n.cml-vrb summary:after{content:\"+\";flex:none;display:grid;place-items:center;width:30px;height:30px;border-radius:50%;border:1px solid var(--ln);color:var(--am);font:400 18px/1 Poppins,sans-serif}\n.cml-vrb details[open] summary:after{content:\"\\2212\"}\n.cml-vrb details p{margin:0;padding:0 2px 18px;font:400 15px/1.6 Poppins,sans-serif;color:var(--mu)}\n.cml-vrb .cl{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:18px;margin:clamp(48px,6vw,80px) auto clamp(40px,5vw,64px);padding:clamp(24px,4vw,40px);border-radius:16px;background:#fbf0dc}\n.cml-vrb .cl h2{font-size:clamp(22px,2.4vw,30px)!important}\n.cml-vrb .cl p{margin:8px 0 0;font:400 15px/1.5 Poppins,sans-serif;color:var(--mu)}\n.cml-vrb .cl a{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 28px;border-radius:10px;background:var(--am);color:#fff!important;font:600 15px/1 Poppins,sans-serif;text-decoration:none!important}\n@media(max-width:900px){.cml-vrb .pp{grid-template-columns:minmax(0,1fr)}.cml-vrb .pp img{aspect-ratio:16/10!important}}\n@media(max-width:640px){.cml-vrb .pp{padding:20px 16px}.cml-vrb .cl a{width:100%}}\n</style>\n<div class=\"cml-vrb\"><div class=\"w\">\n<section class=\"pp\">\n<img src=\"https://cdn.jsdelivr.net/gh/thierryshark/diagnostico@32bb2c139512329fda85e69ae087c3025a65e7c7/chefmaisleve-midia/lancamentos/lc-verao.webp\" alt=\"Chá gelado servido em copos com gelo\" width=\"1000\" height=\"747\" loading=\"lazy\">\n<div>\n<p class=\"e\">Enquanto a linha nova não chega</p>\n<h2>Seu chá misto, <em>gelado</em></h2>\n<ol>\n<li><span><b>Infusão a frio</b><span>Coloque o chá em água fria, numa jarra com tampa, e deixe na geladeira por algumas horas.</span></span></li>\n<li><span><b>Ou do jeito rápido</b><span>Prepare com metade da água quente e, depois da infusão, complete com bastante gelo.</span></span></li>\n<li><span><b>Finalize com fruta</b><span>Uma rodela de laranja ou uma trouxinha dentro do copo deixa tudo mais bonito e perfumado.</span></span></li>\n</ol>\n</div>\n</section>\n<section class=\"fq\">\n<p class=\"e\">Dúvidas</p>\n<h2>Perguntas <em>frequentes</em></h2>\n<details><summary>Quando chegam os chás gelados e a Salada de Fruta?</summary><p>Estamos finalizando na nossa cozinha. Toque em \"Quero ser avisado\" que a gente te chama no WhatsApp quando chegar.</p></details>\n<details><summary>O chocolate derrete no calor?</summary><p>Pode amolecer com calor forte. Se acontecer, deixe alguns minutos na geladeira antes de abrir. Em dias quentes, guardar na geladeira ajuda a manter o chocolate firme.</p></details>\n<details><summary>As frutas têm açúcar ou conservantes?</summary><p>Não colocamos açúcar nem conservantes. As frutas são desidratadas devagar, em pequenos lotes, e a doçura é da própria fruta.</p></details>\n<details><summary>Como guardar as frutas crocantes?</summary><p>Com o pacote bem fechado, em lugar fresco e longe do sol, para continuarem crocantes.</p></details>\n</section>\n<section class=\"cl\">\n<div><h2>O verão começa <em>na pausa.</em></h2><p>Fruta de verdade, feita à mão pela nossa família.</p></div>\n<a href=\"#ns-section-product_list\">Escolher o meu</a>\n</section>\n</div></div>\n", "width": "fill"}}}, "settings": {"_custom_name": "Linha Verao: conteudo", "gap": 0, "horizontal_padding": 0, "section_width": "full", "vertical_padding": 0}}}}